# 後台擁有者信箱（逗號分隔）。空白 = 拒絕所有後台存取。
BUBU_ADMIN_EMAILS=
# 後台登入密碼（至少 8 字元，建議 16 字元以上）。空白 = 無法登入。
ADMIN_PASSWORD=
# 登入 cookie 簽章金鑰（至少 32 個隨機字元，例如 `openssl rand -hex 32`）。
SESSION_SECRET=
# ECPay is deliberately disabled until merchant onboarding and callback testing finish.
ECPAY_ENABLED=false
ECPAY_MODE=test
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
PAYMENT_PUBLIC_ORIGIN=
ECPAY_CALLBACK_READY=false
# Future master-order integration. Do not enable before the receiving API is verified.
DISPATCH_ENABLED=false
DISPATCH_ENDPOINT=
DISPATCH_TOKEN=
# Optional master-system pull API token: at least 32 random characters.
ORDER_API_TOKEN=
