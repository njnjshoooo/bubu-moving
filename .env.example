# Supabase PostgreSQL 連線字串（Supabase → Connect → Transaction pooler，port 6543）。
# 資料表會在第一次連線時自動建立於 `bubu` schema。
DATABASE_URL=
# 後台擁有者信箱（逗號分隔）。空白 = 拒絕所有後台存取。
BUBU_ADMIN_EMAILS=
# 後台登入密碼（至少 8 字元，建議 16 字元以上）。空白 = 無法登入。
ADMIN_PASSWORD=
# 登入 cookie 簽章金鑰（至少 32 個隨機字元，例如 `openssl rand -hex 32`）。
SESSION_SECRET=
# ECPay is deliberately disabled until merchant onboarding and callback testing finish.
ECPAY_ENABLED=false
ECPAY_MODE=test
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
PAYMENT_PUBLIC_ORIGIN=
ECPAY_CALLBACK_READY=false
# Future master-order integration. Do not enable before the receiving API is verified.
DISPATCH_ENABLED=false
DISPATCH_ENDPOINT=
DISPATCH_TOKEN=
# Optional master-system pull API token: at least 32 random characters.
ORDER_API_TOKEN=
# Meta（Facebook）Pixel。只接受 15–16 位數字；空白或格式不符時用預設 1479421600920150。
# 這是 NEXT_PUBLIC_ 變數，會在建置時寫進程式，修改後要重新部署才會生效。
# 有設定 NEXT_PUBLIC_GTM_ID 時，像素仍由網站直接載入，請勿在 GTM 再安裝一次。
NEXT_PUBLIC_META_PIXEL_ID=
